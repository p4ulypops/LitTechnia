# Wordsmithery configuration (v0.3)
#
# Copy to .env and fill in. NEVER commit .env — .gitignore already excludes it.
# Nothing in this file belongs in GitHub Actions secrets: the deploy workflow
# only needs SSH access, and it deliberately leaves the server's .env untouched.
#
# In production the server refuses to start when a required value is missing and
# prints exactly which one. See docs/wordsmithery-security-notes.md.

# ---------------------------------------------------------------- essentials

NODE_ENV=production
PORT=5000

# Public base URL, used to build magic links. Must be https:// in production.
# REQUIRED in production.
APP_URL=https://littechnia.com

# SQLite file holding accounts, sessions, passkeys and books.
# Keep it outside the deployed release directory or in the path the deploy
# workflow excludes from deletion. Back it up.
DATABASE_PATH=/opt/wordsmithery/data/wordsmithery.db

# ---------------------------------------------------------------- passkeys

# The registrable domain, with no scheme, port or path. A passkey created for
# this RP ID only works on this domain. Changing it invalidates every passkey.
# REQUIRED in production.
PASSKEY_RP_ID=littechnia.com

# Shown by the operating system's passkey prompt.
PASSKEY_RP_NAME=Wordsmithery

# Optional. The exact origin WebAuthn ceremonies must come from. Defaults to
# APP_URL, which is right for a single-domain deployment.
# PASSKEY_ORIGIN=https://littechnia.com

# Optional comma-separated extra origins (for example a staging host). Every
# origin listed here may also make state-changing API requests.
# TRUSTED_ORIGINS=https://staging.littechnia.com

# ---------------------------------------------------------------- email

# Resend API key, server-side only — it is never sent to the browser.
# REQUIRED in production. Create a restricted "sending access" key.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Verified sender on your Resend domain. REQUIRED in production.
EMAIL_FROM=Wordsmithery <no-reply@littechnia.com>

# ---------------------------------------------------------------- sessions

# Cookie name; change only if it collides with something else on the domain.
SESSION_COOKIE_NAME=wordsmithery_session

# Session lifetime in days (1–90).
SESSION_TTL_DAYS=30

# Magic-link lifetime in minutes (clamped to 5–60).
MAGIC_LINK_TTL_MINUTES=15

# ---------------------------------------------------------------- development only
#
# The server EXITS with an error if either switch below is set while
# NODE_ENV=production. Never put them in a production .env.

# Return the magic link in the API response and log it, instead of emailing.
# DEV_ECHO_MAGIC_LINK=true

# Create a demo account and seed the three sample books under it, and expose
# POST /api/auth/dev/demo-sign-in for local UI work.
# WORDSMITHERY_DEMO_SEED=true

# Address the demo account uses.
# WORDSMITHERY_DEMO_EMAIL=demo@localhost
